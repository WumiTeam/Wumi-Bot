# =====================================================================
#  WUMI 2.0 — fichier de configuration (.env)
#  Ne partage JAMAIS ce fichier : il contient le token du bot.
#  Apres une modification : redemarre le bot (pm2 restart wumi / npm start).
# =====================================================================

# ------------------------------------------------------------- DISCORD
# Token du bot (Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# Secret OAuth2 (Developer Portal > OAuth2 > Client Secret).
# UNIQUEMENT pour l'Activite de verification : il sert a confirmer aupres de
# Discord l'identite de la personne qui se verifie. Ne le donne a personne.
CLIENT_SECRET=

# Tes identifiants Discord (clic droit sur toi > Copier l'identifiant).
# C'est LE reglage qui dit qui est fondateur : /admin, la liste noire, la
# configuration des tickets et de la verification du support n'obeissent
# qu'a eux. Plusieurs possibles, separes par une virgule.
OWNER_IDS=

# Ton serveur support : le seul ou /admin existe, ou vivent les tickets
# support, la verification par Activite, et les salons de logs ci-dessous.
SUPPORT_GUILD_ID=

# Serveurs d'essai (deploiement instantane des commandes). LAISSE VIDE pour
# un bot public. `node src/deploy-commands.js --vider` enleve les doublons.
GUILD_ID=

# Invitation permanente vers le serveur support (code ou lien complet).
SUPPORT_INVITE=

# Site du bot (bouton « Site » de /invite et du panneau de tickets).
SITE_URL=

# Chemin de la base de donnees (relatif a la racine du projet)
DATABASE_PATH=./data/zhaak.db


# =====================================================================
#  SALONS DE LOGS DU BOT (sur le serveur support)
# ---------------------------------------------------------------------
#  Colle l'ID d'un salon du serveur SUPPORT (clic droit sur le salon >
#  Copier l'identifiant). Un sujet laisse vide part dans LOG_DEFAUT ; si
#  LOG_DEFAUT est vide aussi, ce sujet n'est simplement pas journalise.
#  Le bot doit pouvoir Voir, Envoyer des messages et Joindre des fichiers.
#  Pour verifier : /admin logs test:Vrai
# =====================================================================

# Erreurs du bot (regroupees : une erreur qui se repete = 1 message + compteur)
LOG_ERREURS=
# Qui pinger a une erreur NOUVELLE : ID d'un role ou d'un membre (vide = personne)
LOG_ERREURS_MENTION=
# Secondes minimum entre deux alertes d'une meme erreur (120 par defaut)
LOG_ERREURS_PAUSE=120

# Le bot est ajoute / retire d'un serveur (guild add / guild remove)
LOG_SERVEURS=

# Votes top.gg (webhook en direct + recompenses reclamees avec /voter)
LOG_VOTES=

# Demarrage du bot, deconnexions et reconnexions longues
LOG_DEMARRAGE=

# Chaque commande utilisee, par paquets toutes les 15 s. TRES bavard sur un
# gros bot : laisse vide si tu n'en as pas besoin.
LOG_COMMANDES=

# Tickets du support : ouvertures, fermetures (+ transcription), notes
LOG_TICKETS=

# Verifications du serveur support (reussies et refusees)
LOG_VERIFICATION=

# Tes actions /admin : liste noire, premium offert, serveur quitte, reglages
LOG_ADMIN=

# Abonnements premium Discord (souscription, fin)
LOG_PREMIUM=

# Salon fourre-tout pour tout sujet ci-dessus laisse vide
LOG_DEFAUT=


# =====================================================================
#  ACTIVITE DE VERIFICATION + WEBHOOK TOP.GG (serveur web public)
# ---------------------------------------------------------------------
#  Voir GUIDE-ACTIVITE.txt pour la mise en place pas a pas (Developer
#  Portal, tunnel HTTPS, URL Mapping).
# =====================================================================

# Port du serveur web public (vide = desactive). Il doit etre joignable en
# HTTPS depuis Internet (tunnel Cloudflare, Nginx, Caddy...).
SERVEUR_PUBLIC_PORT=
# Adresse d'ecoute : 127.0.0.1 si un tunnel/proxy tourne sur la meme machine
# (recommande), 0.0.0.0 pour ecouter partout.
SERVEUR_PUBLIC_HOTE=127.0.0.1

# Adresse du TABLEAU DE BORD web (ex. https://dash.wumi.fr). Vide = desactive.
# Il utilise CLIENT_ID et CLIENT_SECRET. Dans le Developer Portal > OAuth2 >
# Redirects, ajoute exactement : <DASHBOARD_URL>/callback
#   ex. https://dash.wumi.fr/callback
# Le meme serveur public sert tout : Caddy envoie dash.wumi.fr ET
# verif.wumi.fr vers SERVEUR_PUBLIC_PORT, le bot trie selon le domaine.
DASHBOARD_URL=
# Port a part pour le tableau de bord (vide = meme port que ci-dessus, tri
# par domaine). Avec Tailscale Funnel, mets 3201 : voir GUIDE-TAILSCALE.txt.
DASHBOARD_PORT=

# true quand l'Activite est activee dans le Developer Portal ET que
# CLIENT_SECRET est rempli. Sinon, le panneau de verification propose un
# code a recopier a la place.
ACTIVITE_ACTIVE=false


# ------------------------------------------------------------- TOP.GG
# Jeton API : https://top.gg/bot/<ton_bot>/webhooks (onglet « API »).
# Sans lui, /voter dit que le bot n'est pas encore inscrit.
TOPGG_TOKEN=
# Mot de passe du webhook (meme page, champ « Authorization »). Invente une
# longue chaine, colle-la des deux cotes, et mets comme URL de webhook :
#   https://<ton-domaine>/topgg
# Vide = pas de webhook (les votes sont alors vus quand on reclame avec /voter).
TOPGG_WEBHOOK_AUTH=


# ------------------------------------------------------------- PREMIUM
# ID du SKU d'abonnement Discord (Developer Portal > Monetization). Vide =
# seul le premium offert avec /admin premium fonctionne.
PREMIUM_SKU_ID=


# ------------------------------------------------------- PANNEAU LOCAL
# Ton outil d'auteur, joignable uniquement depuis la machine du bot
# (http://localhost:PANNEAU_PORT). Ne l'ouvre jamais sur Internet.
PANNEAU_ACTIF=false
# 8 caracteres minimum, sinon le panneau ne demarre pas
PANNEAU_MOTDEPASSE=
PANNEAU_PORT=3000


# ------------------------------------------------------------- VEILLE
# Twitch : https://dev.twitch.tv/console/apps (voir GUIDE-TWITCH.txt)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Instagram : jeton longue duree (voir GUIDE-INSTAGRAM.txt)
INSTAGRAM_TOKEN=
# TikTok : passerelle RSS de secours ({pseudo} = le compte). Vide = config.js
TIKTOK_PASSERELLE=


# ------------------------------------------------------------- DIVERS
# true = affiche les messages de debogage dans la console
DEBUG=false

# Sauvegarde hors du serveur : une fois par semaine, la derniere copie de la
# base part, compressee, en MP au fondateur (OWNER_IDS). Mets ici l'ID d'un
# salon PRIVE du serveur support si tu preferes la recevoir la-bas.
SAUVEGARDE_SALON=

# ---------------------------------------------------------------- Musique
# Rempli tout seul par « bash outils/installer-lavalink.sh » (Java portable +
# Lavalink, lance par pm2). Sans mot de passe, les commandes de musique
# repondent que la musique n'est pas installee.
LAVALINK_URL=http://127.0.0.1:2333
LAVALINK_PASSWORD=
# Connexion YouTube (compte Google SECONDAIRE) : rempli apres le code affiche
# dans « pm2 logs lavalink » au premier lancement. Facultatifs : version forcee
# du plugin YouTube et service de dechiffrage.
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PLUGIN=
YOUTUBE_CIPHER_URL=
